export default `precision highp float;

uniform float u_time;
uniform float u_seed;
uniform vec2 u_resolution;

uniform vec3 u_color1;
uniform vec3 u_color2;
uniform vec3 u_color3;
uniform vec3 u_color4;

uniform float u_colorOpacity1;
uniform float u_colorOpacity2;
uniform float u_colorOpacity3;
uniform float u_colorOpacity4;

uniform vec2 u_mouse;

uniform float u_waveCount;
uniform float u_speed;
uniform float u_amplitude;
uniform float u_frequency;
uniform float u_opacity;
uniform float u_thickness;
uniform float u_blur;
uniform float u_concentration;
uniform float u_randomness;
uniform float u_thicknessRandom;
uniform float u_verticalOffset;
uniform float u_rotation;
uniform float u_splitFill;
uniform float u_lumen;
uniform float u_lumenIntensity;
uniform float u_twist;
uniform float u_twistAmount;
#ifdef HAS_GLASS
uniform float u_glass;
#endif
#ifdef HAS_LIQUID_METAL
uniform float u_liquidMetal;
uniform float u_lmLiquid;
#endif

varying vec2 v_uv;

vec3 snoise_mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec2 snoise_mod289(vec2 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec3 snoise_permute(vec3 x) { return snoise_mod289(((x * 34.0) + 1.0) * x); }

float snoise(vec2 v) {
  const vec4 C = vec4(0.211324865405187, 0.366025403784439,
                       -0.577350269189626, 0.024390243902439);
  vec2 i = floor(v + dot(v, C.yy));
  vec2 x0 = v - i + dot(i, C.xx);
  vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
  vec4 x12 = x0.xyxy + C.xxzz;
  x12.xy -= i1;
  i = snoise_mod289(i);
  vec3 p = snoise_permute(snoise_permute(i.y + vec3(0.0, i1.y, 1.0))
           + i.x + vec3(0.0, i1.x, 1.0));
  vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy),
               dot(x12.zw, x12.zw)), 0.0);
  m = m * m;
  m = m * m;
  vec3 x = 2.0 * fract(p * C.www) - 1.0;
  vec3 h = abs(x) - 0.5;
  vec3 ox = floor(x + 0.5);
  vec3 a0 = x - ox;
  m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
  vec3 g;
  g.x = a0.x * x0.x + h.x * x0.y;
  g.yz = a0.yz * x12.xz + h.yz * x12.yw;
  return 130.0 * dot(m, g);
}

vec3 lumenRender(vec2 uv, float aspect, float t) {
  vec3 col = u_color1;                 
  int wc = int(u_waveCount);

  
  float bodyW = clamp(u_blur * 0.0009 + 0.022, 0.022, 0.18);
  float coreW = clamp(u_thickness * 0.0007 + 0.0012, 0.0012, 0.018);

  
  float spread = 0.82 / (1.0 + u_concentration * 0.15);

  
  vec2 wuv = vec2(uv.x * aspect, uv.y);
  float sharedWarp = snoise(vec2(wuv.x * 0.6, wuv.y * 1.0 + t * 0.20)) * 0.03;

  for (int i = 0; i < 12; i++) {
    if (i >= wc) break;
    float fi = float(i);
    float k  = (fi + 0.5) / max(float(wc), 1.0);   
    float phase = fi * 2.17 + u_seed;

    
    float jitter  = fract(sin(fi * 43.7 + u_seed * 17.3) * 43758.5453) - 0.5;
    float jitter2 = fract(sin(fi * 91.3 + u_seed *  9.1) * 43758.5453);

    
    float nLo = snoise(vec2(wuv.x * 0.8 + phase,       wuv.y * 1.3 + t * 0.16));
    float nHi = snoise(vec2(wuv.x * 2.6 + phase + 3.1, wuv.y * 3.0 + t * 0.11));
    float nX  = snoise(vec2(wuv.x * 1.5 + phase + 7.1, wuv.y * 1.8 - t * 0.13));

    vec2 w = wuv;
    w.y += nLo * 0.04 + nHi * 0.015 + sharedWarp;
    w.x += nX * 0.10;

    
    float mouseInfluence = (u_mouse.x - 0.5) * 0.05;
    w.y += mouseInfluence * sin(w.x * 1.3 + fi);

    
    float baseY = 0.5 + u_verticalOffset + (k - 0.5) * spread;
    float amp   = u_amplitude * (0.7 + 0.6 * jitter2) * (1.0 - u_randomness * 0.3 + u_randomness * jitter);
    float freq  = u_frequency * (0.75 + 0.6 * jitter2);
    float cy = baseY
             + sin(w.x * freq       + t * u_speed       + phase      ) * amp
             + sin(w.x * freq * 2.1 - t * u_speed * 0.7 + phase * 1.7) * amp * 0.45
             + sin(w.x * freq * 0.5 + t * u_speed * 0.3 + phase * 2.9) * amp * 0.6;

    float d = abs(w.y - cy);

    
    float thickJit = fract(sin(fi * 253.3 + u_seed * 197.1) * 43758.5453);
    float bw = bodyW * (1.0 - u_thicknessRandom * 0.5 + u_thicknessRandom * thickJit);
    float cw = coreW * (1.0 - u_thicknessRandom * 0.3 + u_thicknessRandom * thickJit);

    float body = exp(-(d * d) / (bw * bw));
    float core = exp(-(d * d) / (cw * cw));
    
    float hw   = bw * 2.8;
    float haze = exp(-(d * d) / (hw * hw));

    
    
    
    
    float s = w.x * 3.6 + t * 0.55 + fi * 2.3 + nLo * 2.5;
    float a = 0.5 + 0.5 * sin(s);
    float b = 0.5 + 0.5 * sin(s * 0.61 + 1.9 + fi);
    vec3 hue = mix(u_color2, u_color3, a);
    hue      = mix(hue,      u_color4, b);

    
    float colA = mix(u_colorOpacity2, u_colorOpacity3, a);
    colA       = mix(colA, u_colorOpacity4, b);

    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    float bodyK = u_lumenIntensity;
    float coreK = pow(max(u_lumenIntensity, 0.0), 1.5);
    col += hue * haze * u_opacity * colA * 0.10;
    col += hue * body * u_opacity * colA * 0.95 * bodyK;
    col += mix(hue, vec3(1.0), 0.08) * core * u_opacity * 1.4 * coreK;
  }

  return col;
}

void main() {
  vec2 uv = v_uv;
  float aspect = u_resolution.x / u_resolution.y;

  
  if (u_rotation != 0.0) {
    vec2 center = vec2(0.5 * aspect, 0.5);
    vec2 scaled = vec2(uv.x * aspect, uv.y);
    float c = cos(u_rotation);
    float s = sin(u_rotation);
    vec2 d = scaled - center;
    scaled = center + vec2(d.x * c - d.y * s, d.x * s + d.y * c);
    uv = vec2(scaled.x / aspect, scaled.y);
  }

  float t = u_time * u_speed;

  
  if (u_lumen > 0.5) {
    vec3 col = lumenRender(uv, aspect, u_time);
    
    float gn = fract(sin(dot(gl_FragCoord.xy * 0.01, vec2(12.9898, 78.233))) * 43758.5453);
    col += (gn - 0.5) * 0.012;
    gl_FragColor = vec4(col, 1.0);
    return;
  }

  
  float mouseInfluence = (u_mouse.x - 0.5) * 0.08;

  int waveCount = int(u_waveCount);

  
  vec3 color = u_color1;

  
  float range = 0.85 / (1.0 + u_concentration);
  float startY = 0.5 + u_verticalOffset - range / 2.0;

  
  for (int i = 0; i < 100; i++) {
    if (i >= waveCount) break;

    float fi = float(i);
    float phase = fi * 0.7 + u_seed;

    
    float baseY = startY + fi / max(float(waveCount) - 1.0, 1.0) * range;

    
    float waveRand = fract(sin(fi * 127.1 + u_seed * 311.7) * 43758.5453);
    float amp = u_amplitude * (1.0 - u_randomness + u_randomness * waveRand);

    
    float wave = 0.0;
    wave += sin(uv.x * aspect * u_frequency + t * (0.8 + fi * 0.1) + phase) * amp;
    wave += sin(uv.x * aspect * u_frequency * 2.0 - t * (0.5 + fi * 0.15) + phase * 2.0) * amp * 0.4;
    wave += sin(uv.x * aspect * u_frequency * 0.5 + t * (0.3 + fi * 0.05) + phase * 3.0) * amp * 0.6;

    
    wave += mouseInfluence * sin(uv.x * aspect * 3.0 + fi) * 0.3;

    float waveY = baseY + wave;

    
    
    
    
    float cT = 1.0;
    float sT = 0.0;
    if (u_twist > 0.5) {
      float tphase = uv.x * aspect * u_frequency * 1.2
                   + t * 0.6 + u_seed * 0.3 + fi * 0.6;
      cT = cos(tphase);
      sT = sin(tphase);
    }

    
    float thickRand = fract(sin(fi * 253.3 + u_seed * 197.1) * 43758.5453);
    float thickUV = u_thickness / u_resolution.y;
    float blurUV = u_blur / u_resolution.y;
    float thick = thickUV * (1.0 - u_thicknessRandom + u_thicknessRandom * thickRand);
    
    
    float thickTwist = thick * (1.5 + u_twistAmount * 1.5) * abs(cT);
    float thickUsed  = mix(thick, max(thickTwist, thick * 0.05), step(0.5, u_twist) * u_twistAmount);

    
    
    float edge;
    if (u_twist > 0.5) {
      
      
      float dist = abs(uv.y - waveY);
      edge = 1.0 - smoothstep(thickUsed, thickUsed + blurUV, dist);
    } else if (u_splitFill > 0.5) {
      edge = smoothstep(waveY - thickUsed - blurUV, waveY - thickUsed, uv.y);
    } else {
      float dist = abs(uv.y - waveY);
      edge = 1.0 - smoothstep(thickUsed, thickUsed + blurUV, dist);
    }
    
    thick = thickUsed;

    
    float layerAlpha = u_opacity * (0.25 + 0.75 * (fi / max(float(waveCount) - 1.0, 1.0)));
    float alpha = edge * layerAlpha;

    
    float colorMix = fi / max(float(waveCount) - 1.0, 1.0);
    vec3 waveColor;
    float colorAlpha;
    if (colorMix < 0.333) {
      float t = colorMix * 3.0;
      waveColor = mix(u_color2, u_color3, t);
      colorAlpha = mix(u_colorOpacity2, u_colorOpacity3, t);
    } else if (colorMix < 0.666) {
      float t = (colorMix - 0.333) * 3.0;
      waveColor = mix(u_color3, u_color4, t);
      colorAlpha = mix(u_colorOpacity3, u_colorOpacity4, t);
    } else {
      float t = (colorMix - 0.666) * 3.0;
      waveColor = mix(u_color4, u_color2, t);
      colorAlpha = mix(u_colorOpacity4, u_colorOpacity2, t);
    }

    
    float brightness = 0.95 + 0.1 * sin(uv.x * aspect * 3.0 + t * 0.5 + fi);
    waveColor *= brightness;

    
    
    
    if (u_twist > 0.5) {
      
      float yRel = clamp((uv.y - waveY) / max(thick, 1e-5), -1.0, 1.0);
      float faceT = smoothstep(-0.15, 0.15, cT);   

      
      
      vec3 frontBase = waveColor * 0.80;
      vec3 backBase  = waveColor * 0.10;
      vec3 base = mix(backBase, frontBase, faceT);

      
      
      
      float specPos = yRel + sT * 0.9;
      float spec = exp(-specPos * specPos * 7.0) * faceT;
      vec3 specCol = vec3(2.2) * spec;

      
      float spec2Pos = yRel + sT * 0.6;
      float spec2 = exp(-spec2Pos * spec2Pos * 40.0) * faceT;
      specCol += vec3(2.5, 2.4, 2.6) * spec2;

      
      
      float rimBand = pow(clamp(abs(yRel) - 0.55, 0.0, 1.0) / 0.45, 1.5);
      float rimFace = pow(1.0 - abs(cT), 1.6);
      float rim = rimBand * rimFace;
      vec3 rimCol = mix(vec3(1.0, 0.78, 0.5), vec3(0.6, 0.7, 1.0),
                        0.5 + 0.5 * sin(uv.x * aspect * u_frequency + t + fi));
      vec3 rimAdd = rimCol * rim * 1.3;

      vec3 twistedColor = base + specCol + rimAdd;
      waveColor = mix(waveColor, twistedColor, u_twistAmount);
    }

#ifdef HAS_GLASS
    
    if (u_glass > 0.5) {
      float gDistFromWave = uv.y - waveY;
      float gAbsDist = abs(gDistFromWave);
      float gBandWidth = thick + blurUV + 0.02;

      waveColor = mix(waveColor, color, 0.4);

      float gDx = cos(uv.x * aspect * u_frequency + t * (0.8 + fi * 0.1) + phase) * amp;
      float refractedY = uv.y + gDx * 0.1;
      float refractTint = smoothstep(0.3, 0.7, refractedY);
      waveColor = mix(waveColor, waveColor * (0.8 + refractTint * 0.4), 0.5);

      float caustic1 = sin(uv.x * aspect * u_frequency * 3.0 + t * 1.2 + phase * 2.0) * 0.5 + 0.5;
      float caustic2 = sin(uv.x * aspect * u_frequency * 5.0 - t * 0.8 + phase * 3.0) * 0.5 + 0.5;
      float gNearCenter = 1.0 - smoothstep(0.0, gBandWidth * 0.6, gAbsDist);
      waveColor += vec3(pow(caustic1 * caustic2, 2.0) * gNearCenter * 0.15);

      float gEdge = smoothstep(0.0, gBandWidth, gAbsDist);
      waveColor += vec3(pow(gEdge, 0.8) * (1.0 - gEdge) * 0.25);

      waveColor += vec3(pow(max(0.0, 1.0 - gAbsDist / (gBandWidth * 0.15)), 6.0) * 0.12);

      alpha *= 0.75;
    }
#endif

#ifdef HAS_LIQUID_METAL
    
    if (u_liquidMetal > 0.5) {
      float mDist = uv.y - waveY;
      float absDist = abs(mDist);
      float bandWidth = thick + blurUV + 0.02;
      float normDist = clamp(absDist / bandWidth, 0.0, 1.0);

      
      float edgeMask = smoothstep(1.0, 0.8, normDist);

      
      float lmT = u_time * 0.3;
      float dx = cos(uv.x * aspect * u_frequency + t * (0.8 + fi * 0.1) + phase) * amp;
      float slope = dx * 2.0;

      
      float n1 = snoise(vec2(uv.x * aspect * 1.5 + fi, waveY * 4.0) - lmT * 0.5);
      float n2 = snoise(vec2(uv.x * aspect * 3.0 - fi * 0.5, waveY * 8.0) + lmT * 0.3);
      float n3 = snoise(vec2(uv.x * aspect * 0.8 + fi * 2.0, uv.y * 3.0) - lmT * 0.2);

      
      float liquidSlope = slope + n1 * u_lmLiquid * 4.0 + n2 * u_lmLiquid * 2.0;
      float liquidDist = normDist + n3 * u_lmLiquid * 0.5;
      liquidDist = clamp(liquidDist, 0.0, 1.0);

      
      float envAngle = liquidSlope * 0.3 + mDist / bandWidth * 0.5;
      envAngle = envAngle * 0.5 + 0.5; 
      envAngle = clamp(envAngle, 0.0, 1.0);

      
      float envCurve = sin(envAngle * 3.14159) ;
      float envBright = pow(envCurve, 0.6);

      
      vec3 metalColor = mix(vec3(0.02, 0.02, 0.03), vec3(0.95, 0.93, 0.98), envBright);

      
      vec3 tint = waveColor * 1.2 + vec3(0.1);
      
      float hueShift = envAngle * 0.5 + liquidSlope * 0.2;
      vec3 iridescentTint = mix(tint, tint.gbr, smoothstep(0.3, 0.7, hueShift));
      metalColor = mix(metalColor, metalColor * iridescentTint, 0.5 + envBright * 0.3);

      
      float spec = pow(max(0.0, 1.0 - liquidDist * 2.5), 3.0);
      metalColor += vec3(0.95, 0.9, 1.0) * spec * 0.4;

      
      float spec2 = pow(max(0.0, 1.0 - abs(liquidDist - 0.3) * 4.0), 2.0);
      metalColor += vec3(0.8, 0.75, 0.9) * spec2 * 0.15;

      
      float fresnel = pow(liquidDist, 0.4) * pow(1.0 - liquidDist, 0.8);
      metalColor += vec3(0.9, 0.85, 1.0) * fresnel * 0.5;

      
      float depth = smoothstep(-bandWidth * 0.5, bandWidth * 0.5, mDist);
      metalColor *= 0.6 + depth * 0.6;

      
      metalColor = pow(metalColor, vec3(0.9));

      
      waveColor = mix(waveColor, metalColor, edgeMask);
    }
#endif

    color = mix(color, waveColor, alpha * colorAlpha);
  }

  
  float grain = fract(sin(dot(gl_FragCoord.xy * 0.01, vec2(12.9898, 78.233))) * 43758.5453);
  color += (grain - 0.5) * 0.012;

  gl_FragColor = vec4(color, 1.0);
}`